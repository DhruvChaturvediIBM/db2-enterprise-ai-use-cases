DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=BLUDB
DB2_USERNAME=db2inst1
DB2_PASSWORD=change-me
DB2_SCHEMA=AI_DEMO
# UC13 uses its own table with plain document_id/title columns
# so DB2VectorSearchTool can return them without BLOB deserialisation.
KNOWLEDGE_TABLE=RESEARCH_KNOWLEDGE

OLLAMA_BASE_URL=http://localhost:11434
# llama3.1:8b has native tool-calling support required for CrewAI ReAct loop.
# granite3.1-dense:8b simulates tool calls in text rather than invoking them.
LLM_MODEL=llama3.1:8b

# Must match the model used to seed the KNOWLEDGE_BASE table.
# The shared corpus was seeded with nomic-embed-text via Ollama.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
RETRIEVAL_TOP_K=10
DISTANCE_METRIC=COSINE
