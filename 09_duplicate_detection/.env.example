DB2_DATABASE=BLUDB
DB2_HOST=localhost
DB2_PORT=50000
DB2_USERNAME=db2user
DB2_PASSWORD=change_me
DB2_SECURITY=false
DB2_TABLE=AI_DEMO.KNOWLEDGE_BASE

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

TOP_K=5
# Calibrated for nomic-embed-text cosine similarity on this corpus.
# Similarity = 1 - cosine_distance. Max achievable ~0.73 on 19-doc corpus.
# DUPLICATE = similarity >= 0.75  (near-paraphrase of an existing document)
# RELATED   = similarity >= 0.55  (same topic, different content)
# NEW       = similarity <  0.55  (genuinely absent from the knowledge base)
DUPLICATE_THRESHOLD=0.75
RELATED_THRESHOLD=0.55
