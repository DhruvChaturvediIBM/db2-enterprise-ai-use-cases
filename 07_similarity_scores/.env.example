DB2_DATABASE=BLUDB
DB2_HOST=localhost
DB2_PORT=50000
DB2_USERNAME=db2user
DB2_PASSWORD=change_me
DB2_SECURITY=false

DB2_TABLE=AI_DEMO.KNOWLEDGE_BASE

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=granite3.1-dense:8b

TOP_K=5
# Calibrated for nomic-embed-text cosine distances on this corpus.
# nomic-embed-text distances cluster ~0.27–0.50 (unlike theoretical 0.0–1.0).
# HIGH   = top result distance <= 0.35  (strong, on-topic match)
# MEDIUM = top result distance <= 0.52  (related but not precise)
# LOW    = top result distance >  0.52  (not in corpus)
HIGH_MAX_DISTANCE=0.35
MEDIUM_MAX_DISTANCE=0.52
